with "gtkada";

project Emu is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("adazx.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnatn", "-gnat2012", "-gnatwa", "-gnatwK", "-g");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-E");
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use ("-lpulse-simple", "-lpulse",
                                         "-l:libgtksourceview-4.so.0", "-lz");
   end Linker;
end Emu;
