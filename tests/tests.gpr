project Tests is
   for Source_Dirs use ("../src", ".");
   for Object_Dir use "../obj/tests";
   for Exec_Dir use "../bin";
   for Main use ("fuse_test.adb", "zex_test.adb", "asm_test.adb", "dis.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2012", "-g");
   end Compiler;
end Tests;
